APP_NAME="Pixelfed"
APP_ENV="production"
APP_KEY="{{ pixelfed_app_key }}"
APP_DEBUG="false"

OPEN_REGISTRATION="false"
ENFORCE_EMAIL_VERIFICATION="false"
PF_MAX_USERS="1000"
OAUTH_ENABLED="true"
ENABLE_CONFIG_CACHE="true"
INSTANCE_DISCOVER_PUBLIC="true"

PF_OPTIMIZE_IMAGES="true"
IMAGE_QUALITY="80"
MAX_PHOTO_SIZE="15000"
MAX_CAPTION_LENGTH="500"
MAX_ALBUM_LENGTH="4"

APP_URL="{{ pixelfed_app_url }}"
APP_DOMAIN="{{ pixelfed_domain }}"
ADMIN_DOMAIN="{{ pixelfed_domain }}"
SESSION_DOMAIN="{{ pixelfed_domain }}"
TRUST_PROXIES="*"

DB_CONNECTION="mysql"
DB_HOST="{{ pixelfed_db_host }}"
DB_PORT="{{ pixelfed_db_port }}"
DB_DATABASE="{{ pixelfed_db_name }}"
DB_USERNAME="{{ pixelfed_db_user }}"
DB_PASSWORD="{{ pixelfed_db_password }}"

REDIS_CLIENT="predis"
REDIS_SCHEME="tcp"
REDIS_HOST="{{ pixelfed_redis_host }}"
REDIS_PASSWORD="null"
REDIS_PORT="{{ pixelfed_redis_port }}"

SESSION_DRIVER="database"
CACHE_DRIVER="redis"
QUEUE_DRIVER="redis"
BROADCAST_DRIVER="log"
LOG_CHANNEL="stack"
HORIZON_PREFIX="horizon-"

ACTIVITY_PUB="false"
AP_REMOTE_FOLLOW="false"
AP_INBOX="false"
AP_OUTBOX="false"
AP_SHAREDINBOX="false"

EXP_EMC="true"

MAIL_DRIVER="log"
MAIL_HOST=""
MAIL_PORT=""
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_ENCRYPTION=""
MAIL_FROM_ADDRESS="pixelfed@{{ pixelfed_domain }}"
MAIL_FROM_NAME="Pixelfed"
MAIL_AUTO_TLS="false"

PF_ENABLE_CLOUD=false

